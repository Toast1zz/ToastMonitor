{"nodes": [{"id": "docs_token_collection_document", "label": "Token Collection Document", "file_type": "document", "source_file": "docs/token-collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_token_collection_byte_offset_cursor", "label": "Byte-Offset Cursor Incremental Parsing", "file_type": "rationale", "source_file": "docs/token-collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File changes are detected via (size, nanosecond mtime, inode); the cursor parses only appended lines and a partial trailing line is never consumed, so steady-state idle scans cost ~20ms"}, {"id": "docs_token_collection_dedupe_chain", "label": "Dedupe Chain", "file_type": "rationale", "source_file": "docs/token-collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upstream event ID to derived ID (file + inode + mtime + byte offset) to a global unique index on (tool, event_id) with INSERT OR IGNORE ensures re-scanning or replaying never double-counts"}, {"id": "docs_token_collection_delta_baseline", "label": "Cumulative Delta Baseline Mechanism", "file_type": "rationale", "source_file": "docs/token-collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cumulative rows (OpenCode, Hermes) are converted to deltas against persisted baselines; shrinking fields clamp to 0 and shared keys across local/remote prevent double-counting on source switch"}, {"id": "docs_token_collection_token_total_formula", "label": "Master Token Total Formula", "file_type": "rationale", "source_file": "docs/token-collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Total tokens = input + output + cacheRead; the only excepti